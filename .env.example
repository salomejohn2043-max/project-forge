# KISII EATS - ENVIRONMENT CONFIGURATION
# Copy to .env.local and fill values

# SUPABASE
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# M-PESA DARAJA API
VITE_MPESA_CONSUMER_KEY=your_m_pesa_consumer_key
VITE_MPESA_CONSUMER_SECRET=your_m_pesa_consumer_secret
VITE_MPESA_SHORTCODE=your_m_pesa_shortcode
VITE_MPESA_PASSKEY=your_m_pesa_passkey
VITE_MPESA_ENVIRONMENT=sandbox

# GOOGLE MAPS
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# APP CONFIG
VITE_APP_NAME=Kisii Eats
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_EMAIL=admin@kisiieats.com
